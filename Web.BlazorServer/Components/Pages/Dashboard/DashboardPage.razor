@using Web.BlazorServer.Components.Pages.Dashboard.Components
@using Web.BlazorServer.Components.Security
@page "/dashboard"
@layout ProtectedLayout
@inherits BaseComponent
@attribute [AppAuthorizationAttribute("VIEW", "ODSB")]

<PageTitle>Dashboard</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="ODSB" />
</RadzenStack>

<RadzenStack Orientation="Orientation.Horizontal"  JustifyContent="JustifyContent.Center" Gap="10" Wrap="FlexWrap.Wrap">
    <DashboardCard 
        Title="Deliveries" 
        TotalCount="@DeliveryCount" 
        IsBusy="@IsBusy"
        Icon="Unarchive"
        TodayCount="@DeliveryTodayCount"
        Link="/transactions/sales/delivery" />
    <DashboardCard 
        Title="Returns" 
        TotalCount="@ReturnsCount" 
        IsBusy="@IsBusy"
                   Icon="Assignment_Return"
                   TodayCount="@ReturnsTodayCount"
        Link="/transactions/sales/sales-return" />
    <DashboardCard 
        Title="Receiving" 
        TotalCount="@ReceivingCount" 
        IsBusy="@IsBusy"
                   Icon="Archive"
                   TodayCount="@ReceivingTodayCount"
        Link="/transactions/purchasing/receiving" />
</RadzenStack>