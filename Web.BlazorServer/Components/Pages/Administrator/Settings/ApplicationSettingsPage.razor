@page "/administration/settings/system-configuration"
@layout ProtectedLayout
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Administration.Settings
@attribute [AppAuthorizationAttribute("VIEW", "OSYS")]

@inherits BaseComponent

<PageTitle>System Configuration</PageTitle>

<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" class="rz-mb-4">
    <AppBreadCrumbs ModuleCode="OSYS" />
    <RadzenStack Orientation="Orientation.Horizontal"
                 JustifyContent="JustifyContent.End"
                 AlignItems="AlignItems.Center"
                 Gap="8px">

        <RadzenButton Visible="@(!IsEditing)"
                      Text="Edit"
                      Icon="edit"
                      ButtonStyle="ButtonStyle.Primary"
                      Disabled="@IsAnyBusy"
                      Click="@OnEdit" />

        <RadzenButton Visible="@IsEditing"
                      Text="Cancel"
                      ButtonStyle="ButtonStyle.Base"
                      Disabled="@IsSavingBusy"
                      Click="@CancelEdit" />

        <RadzenButton Visible="@IsEditing"
                      Text="Save Changes"
                      Icon="save"
                      ButtonStyle="ButtonStyle.Success"
                      Disabled="@IsAnyBusy"
                      Click="@SaveChanges" />
    </RadzenStack>
</RadzenStack>

<AppContent>
    <RadzenStack Gap="16px">

        <RadzenCard Visible="@(InventoryCountingPostingCycleSetting is not null)">
            <RadzenStack Gap="8px">
                <RadzenStack Gap="2px">
                    <RadzenText Text="@InventoryCountingPostingCycleSetting?.Name" TextStyle="TextStyle.H6" class="rz-m-0" />
                    <RadzenText Text="@InventoryCountingPostingCycleSetting?.Description" TextStyle="TextStyle.Body2" class="rz-m-0" />
                </RadzenStack>
                <RadzenDropDown TValue="string"
                                @bind-Value="@InventoryCountingPostingCycleSetting!.Value"
                                Data="@CycleTypeOptions"
                                ValueProperty="Value"
                                TextProperty="Label"
                                Style="width: 220px;"
                                Disabled="@(!IsEditing || IsSavingBusy)" />
            </RadzenStack>
        </RadzenCard>

        <RadzenCard Visible="@(MaxFailedLoginAttemptsSetting is not null)">
            <RadzenStack Gap="8px">
                <RadzenStack Gap="2px">
                    <RadzenText Text="@MaxFailedLoginAttemptsSetting?.Name" TextStyle="TextStyle.H6" class="rz-m-0" />
                    <RadzenText Text="@MaxFailedLoginAttemptsSetting?.Description" TextStyle="TextStyle.Body2" class="rz-m-0" />
                </RadzenStack>
                <RadzenNumeric TValue="int"
                               @bind-Value="@MaxFailedLoginAttempts"
                               Min="1"
                               Max="100"
                               Style="width: 150px;"
                               Disabled="@(!IsEditing || IsSavingBusy)" />
            </RadzenStack>
        </RadzenCard>

    </RadzenStack>
</AppContent>
