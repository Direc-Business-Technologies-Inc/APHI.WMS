@using Web.BlazorServer.Components.Pages.Transaction.GoodsReturn.Components.Cards
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Administration.User
@using Web.BlazorServer.ViewModels.Transaction.GoodsReturn
@using Web.BlazorServer.ViewModels.Transaction.Receiving

@inherits BaseComponent
<RadzenMediaQuery Query="(max-width: 912px)" Change="OnChange" />

<AppDataGrid @ref="@GoodsReturnRequestDataGrid" Id="goods_return_request_grid" TItem="GRRDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@GoodsReturnRequestDataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" ActionName="@ActionGetGoodsReturnRequests" SearchFilter="@_searchFilter">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <AppDataGridSearchBar TItem="GRRDataGridVM"
                                  @bind-SearchFilter="_searchFilter"
                                  OnSearch="OnSearchAsync"
                                  Properties="@(new[] { nameof(GRRDataGridVM.CardCode), nameof(GRRDataGridVM.CardName), nameof(GRRDataGridVM.DocNum) })" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="GoodsReturnRequestDataGrid.ReloadDataAsync" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        
        @if (IsSmallScreen)
        {

            <RadzenDataGridColumn TItem="GRRDataGridVM" Filterable="false" Pickable="false" Sortable="false">
                <Template Context="context">
                    <GoodsReturnRequestCard GoodsReturn="context" OnClick="ViewGoodsReturnRequest"/>
                </Template>
            </RadzenDataGridColumn>
        }
        else
        {
            
        <RadzenDataGridColumn TItem="GRRDataGridVM"
                              Property="@nameof(GRRDataGridVM.DocNum)"
                              Type="@typeof(int)"
                              Title="GRR Doc No." />
        <RadzenDataGridColumn TItem="GRRDataGridVM"
                              Property="@nameof(GRRDataGridVM.DocDate)"
                              Type="@typeof(DateOnly)"
                              FormatString="{0:d}"
                              Title="GRPO Date">
            <Template>
                @context.DocDate.ToString("MM/dd/yyyy")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GRRDataGridVM"
                              Property="@nameof(GRRDataGridVM.GRPODocNum)"
                              Type="@typeof(int)"
                              Title="GRPO Doc No." />
        <RadzenDataGridColumn TItem="GRRDataGridVM"
                              Property="@nameof(GRRDataGridVM.CardName)"
                              Type="@typeof(string)"
                              Title="Supplier Name" />
        
        <RadzenDataGridColumn TItem="GRRDataGridVM"
                              Property="@nameof(GRRDataGridVM.Remarks)"
                              Type="@typeof(string)"
                              Title="Remarks" />
        <RadzenDataGridColumn TItem="GRRDataGridVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Filterable="false"
                              Sortable="false"
                              Width="35px">
            <Template>
                <RadzenButton Icon="visibility" Size="ButtonSize.ExtraSmall" Click="() => ViewGoodsReturnRequest(context)" />
            </Template>
        </RadzenDataGridColumn>
        }
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="GRRDataGridVM"
                                    @bind-Grid=@GoodsReturnRequestDataGrid.DataGrid
                                    @bind-GridSettings=@GoodsReturnRequestDataGridSettings />,
        options: GridSettingsService.GetDialogOptions());

        await GoodsReturnRequestDataGrid.DataGrid.Reload();
    }
    bool IsSmallScreen = false;
    async Task OnChange(bool matches)
    {
        if (matches != IsSmallScreen)
        {
            IsSmallScreen = matches;
            await InvokeAsync(StateHasChanged);
        }
    }
}