@using Web.BlazorServer.Helpers
@using Web.BlazorServer.ViewModels.Transaction.GoodsReturn
@inherits BaseComponent


<RadzenCard onclick="@(() => OnClick.InvokeAsync(GoodsReturn))" Variant="Variant.Outlined">
    <RadzenStack Gap="0" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.Subtitle2">PO <strong>@GoodsReturn.DocNum</strong></RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle2">@GoodsReturn.DocDate.ToShortDateString()</RadzenText>
    </RadzenStack>
    <RadzenRow class="rz-mt-2" Gap="0" RowGap="0">
        <RadzenColumn SizeXS="12" SizeSM="10">
            <RadzenText TextStyle="TextStyle.Overline" class="rz-mt-2 rz-my-0">Supplier Name</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" class="rz-my-0 rz-text-truncate">@GoodsReturn.CardName.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
        <RadzenColumn>
            <RadzenText TextStyle="TextStyle.Overline" class="rz-mt-4 rz-my-0">Remarks</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0 rz-text-truncate rz-text-caption">@GoodsReturn.Remarks.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>


@code {
    [Parameter]
    [EditorRequired]
    public GoodsReturnDataGridVM GoodsReturn { get; set; }

    [Parameter]
    public EventCallback<GoodsReturnDataGridVM> OnClick { get; set; }
}