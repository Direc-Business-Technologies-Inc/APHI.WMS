@using Web.BlazorServer.Components.Pages.Transaction.GoodsReturn.Components.Cards
@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Administration.User
@using Web.BlazorServer.ViewModels.Transaction.GoodsReturn
@using Web.BlazorServer.ViewModels.Transaction.Receiving

@inherits BaseComponent
<RadzenMediaQuery Query="(max-width: 912px)" Change="OnChange" />

<AppDataGrid @ref="@GoodsReturnDataGrid" Id="goods_return_grid" TItem="GoodsReturnDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@GoodsReturnDataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" ActionName="@ActionGetGoodsReturns" SearchFilter="@_searchFilter">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <AppDataGridSearchBar TItem="GoodsReturnDataGridVM"
                                  @bind-SearchFilter="_searchFilter"
                                  OnSearch="OnSearchAsync"
                                  Properties="@(new[] { nameof(GoodsReturnDataGridVM.CardCode), nameof(GoodsReturnDataGridVM.CardName), nameof(GoodsReturnDataGridVM.DocNum) })" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="GoodsReturnDataGrid.ReloadDataAsync" />
                <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@CreateGoodsReturn" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        @if (IsSmallScreen)
        {
            
            <RadzenDataGridColumn TItem="GoodsReturnDataGridVM" Filterable="false" Pickable="false" Sortable="false">
                <Template Context="context">
                    <GoodsReturnCard GoodsReturn="context" OnClick="ViewGoodsReturn"/>
                </Template>
            </RadzenDataGridColumn>
        }
        else
        {
        <RadzenDataGridColumn TItem="GoodsReturnDataGridVM"
                              Property="@nameof(GoodsReturnDataGridVM.DocNum)"
                              Type="@typeof(int)"
                              Title="PO Doc No." />
        <RadzenDataGridColumn TItem="GoodsReturnDataGridVM"
                              Property="@nameof(GoodsReturnDataGridVM.DocDate)"
                              Type="@typeof(DateOnly)"
                              FormatString="{0:d}"
                              Title="PO Date">
            <Template>
                @context.DocDate.ToString("MM/dd/yyyy")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GoodsReturnDataGridVM"
                              Property="@nameof(GoodsReturnDataGridVM.CardName)"
                              Type="@typeof(string)"
                              Title="Supplier Name" />
        
        <RadzenDataGridColumn TItem="GoodsReturnDataGridVM"
                              Property="@nameof(GoodsReturnDataGridVM.Remarks)"
                              Type="@typeof(string)"
                              Title="Remarks" />
        <RadzenDataGridColumn TItem="GoodsReturnDataGridVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Filterable="false"
                              Sortable="false"
                              Width="35px">
            <Template>
                <RadzenButton Icon="visibility" Size="ButtonSize.ExtraSmall" Click="() => ViewGoodsReturn(context)" />
            </Template>
        </RadzenDataGridColumn>
        }
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="GoodsReturnDataGridVM"
                                    @bind-Grid=@GoodsReturnDataGrid.DataGrid
                                    @bind-GridSettings=@GoodsReturnDataGridSettings />,
        options: GridSettingsService.GetDialogOptions());

        await GoodsReturnDataGrid.DataGrid.Reload();
    }

    bool IsSmallScreen = false;
    async Task OnChange(bool matches)
    {
        if (matches != IsSmallScreen)
        {
            IsSmallScreen = matches;
            await InvokeAsync(StateHasChanged);
        }
    }
}