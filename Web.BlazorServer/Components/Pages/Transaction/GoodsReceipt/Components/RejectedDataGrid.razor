@using Web.BlazorServer.ViewModels.Transaction.GoodsReceipt

@inherits BaseComponent
<RadzenMediaQuery Query="(max-width: 912px)" Change="OnChange" />

<AppDataGrid @ref="@GoodsReceiptDataGrid" Id="rejected_goods_issue_grid" TItem="GoodsReceiptDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@GoodsReceiptDataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" ActionName="@ActionGetGoodsReceipts" SearchFilter="@_searchFilter">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <AppDataGridSearchBar TItem="GoodsReceiptDataGridVM"
                                  @bind-SearchFilter="_searchFilter"
                                  OnSearch="OnSearchAsync"
                                  Properties="@(new[] { nameof(GoodsReceiptDataGridVM.TransTypeName), nameof(GoodsReceiptDataGridVM.AcctName), nameof(GoodsReceiptDataGridVM.PreparedBy), nameof(GoodsReceiptDataGridVM.DocEntry) })" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="GoodsReceiptDataGrid.ReloadDataAsync" />
                <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@CreateGoodsReceipt" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        @if (IsSmallScreen)
        {
            <RadzenDataGridColumn TItem="GoodsReceiptDataGridVM" Filterable="false" Pickable="false" Sortable="false">
                <Template Context="context">
                    <GoodsReceiptCard GoodsReceipt="context" OnClick="ViewGoodsReceipt" />
                </Template>
            </RadzenDataGridColumn>
        }
        else
        {
            <RadzenDataGridColumn TItem="GoodsReceiptDataGridVM"
                                  Property="@nameof(GoodsReceiptDataGridVM.DocEntry)"
                                  Type="@typeof(int)"
                                  Title="Doc No." />
            <RadzenDataGridColumn TItem="GoodsReceiptDataGridVM"
                                  Property="@nameof(GoodsReceiptDataGridVM.DocDate)"
                                  Type="@typeof(DateOnly)"
                                  FormatString="{0:d}"
                                  Title="Doc Date">
                <Template>
                    @context.DocDate.ToString("MM/dd/yyyy")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="GoodsReceiptDataGridVM"
                                  Property="@nameof(GoodsReceiptDataGridVM.PreparedBy)"
                                  Type="@typeof(string)"
                                  Title="Prepared By" />
            <RadzenDataGridColumn TItem="GoodsReceiptDataGridVM"
                                  Property="@nameof(GoodsReceiptDataGridVM.TransTypeName)"
                                  Type="@typeof(string)"
                                  Title="Trans. Type" />
            <RadzenDataGridColumn TItem="GoodsReceiptDataGridVM"
                                  Frozen
                                  FrozenPosition="FrozenColumnPosition.Right"
                                  Type="@typeof(DateOnly)"
                                  FormatString="{0:d}"
                                  Width="35px">
                <Template>
                    <RadzenButton Icon="visibility" Size="ButtonSize.ExtraSmall" Click="() => ViewGoodsReceipt(context)" />
                </Template>
            </RadzenDataGridColumn>
        }
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="GoodsReceiptDataGridVM"
                                    @bind-Grid=@GoodsReceiptDataGrid.DataGrid
                                    @bind-GridSettings=@GoodsReceiptDataGridSettings />,
        options: GridSettingsService.GetDialogOptions());

        await GoodsReceiptDataGrid.DataGrid.Reload();
    }
    bool IsSmallScreen = false;

    async Task OnChange(bool matches)
    {
        if (matches != IsSmallScreen)
        {
            IsSmallScreen = matches;
            await InvokeAsync(StateHasChanged);
        }
    }
}