@using Web.BlazorServer.Helpers
@using Web.BlazorServer.ViewModels.Transaction.SalesReturn
@inherits BaseComponent

<RadzenCard onclick="@(() => OnClick.InvokeAsync(SalesReturn))" Variant="Variant.Outlined">
    <RadzenStack Gap="0" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.Subtitle2"><strong>@SalesReturn.DocEntry</strong></RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle2">@SalesReturn.DocDate.ToShortDateString()</RadzenText>
    </RadzenStack>
    <RadzenRow class="rz-mt-2" Gap="0.5em" RowGap="0">
        <RadzenColumn>
            <RadzenText TextStyle="TextStyle.Overline" class="rz-mt-2 rz-my-0">Customer Name</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" class="rz-my-0 rz-text-truncate">@SalesReturn.CardName.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
        <RadzenColumn>
            <RadzenText TextStyle="TextStyle.Overline" class="rz-mt-2 rz-my-0">Customer Code</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0  rz-text-truncate rz-text-caption">@SalesReturn.CardCode.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12">
            <RadzenText TextStyle="TextStyle.Overline" class="rz-mt-4 rz-my-0">Remarks</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0 rz-text-truncate rz-text-caption">@SalesReturn.Remarks.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>


@code {
    [Parameter]
    [EditorRequired]
    public SalesReturnDataGridVM SalesReturn { get; set; }
    [Parameter]
    public EventCallback<SalesReturnDataGridVM> OnClick { get; set; }
}