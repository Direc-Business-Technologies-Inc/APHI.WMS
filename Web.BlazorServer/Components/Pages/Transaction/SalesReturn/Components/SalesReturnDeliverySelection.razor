@using Web.BlazorServer.ViewModels.Transaction.Delivery
@using Web.BlazorServer.ViewModels.Transaction.SalesReturn

@inherits BaseComponent

<AppDataGrid @ref="@DeliveryDataGrid" Id="sales_return_delivery_selection_grid" TItem="DeliveryDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@DeliveryDataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" ActionName="@ActionGetDeliveries" ClearOnDispose="true" SearchFilter="@_searchFilter">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <AppDataGridSearchBar TItem="DeliveryDataGridVM"
                                  @bind-SearchFilter="_searchFilter"
                                  OnSearch="OnSearchAsync"
                                  Properties="@(new[] { nameof(DeliveryDataGridVM.CardCode), nameof(DeliveryDataGridVM.CardName), nameof(DeliveryDataGridVM.Remarks) })" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="DeliveryDataGrid.ReloadDataAsync" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        <RadzenDataGridColumn TItem="DeliveryDataGridVM"
                              Property="@nameof(DeliveryDataGridVM.DocNum)"
                              Type="@typeof(int)"
                              Title="Delivery Doc No." />
        <RadzenDataGridColumn TItem="DeliveryDataGridVM"
                              Property="@nameof(DeliveryDataGridVM.DocDate)"
                              Type="@typeof(DateTime)"
                              Title="Doc Date">
            <Template>
                @context.DocDate.ToString("MM/dd/yyyy")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="DeliveryDataGridVM"
                              Property="@nameof(DeliveryDataGridVM.CardCode)"
                              Type="@typeof(string)"
                              Title="Customer Code" />
        <RadzenDataGridColumn TItem="DeliveryDataGridVM"
                              Property="@nameof(DeliveryDataGridVM.CardName)"
                              Type="@typeof(string)"
                              Title="Customer Name" />
        <RadzenDataGridColumn TItem="DeliveryDataGridVM"
                              Property="@nameof(DeliveryDataGridVM.Remarks)"
                              Type="@typeof(string)"
                              Title="Remarks" />
        <RadzenDataGridColumn TItem="DeliveryDataGridVM"
                              Frozen
                              Filterable="false"
                              Sortable="false"
                              FrozenPosition="FrozenColumnPosition.Right"
                              Width="35px">
            <Template>
                <RadzenButton Icon="@(_selection.Contains(context.DocEntry) ? "check_box" : "check_box_outline_blank")"
                              Size="ButtonSize.ExtraSmall"
                              Variant="Variant.Text"
                              Click="() => ToggleSelection(context.DocEntry)" />
            </Template>
        </RadzenDataGridColumn>
    </GridColumns>
</AppDataGrid>
<RadzenStack Orientation="Orientation.Horizontal" Gap="0.5em" JustifyContent="JustifyContent.End">
    <RadzenButton ButtonType="ButtonType.Button" Text="Clear Selection" Click="@(_ => _selection.Clear())" Disabled="@IsLoadingData" />
    <RadzenButton ButtonType="ButtonType.Button" ButtonStyle="ButtonStyle.Success" Text="Select" Click="@(_ => Select())" Disabled="@IsLoadingData" />
</RadzenStack>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="DeliveryDataGridVM"
                                    @bind-Grid=@DeliveryDataGrid.DataGrid
                                    @bind-GridSettings=@DeliveryDataGridSettings />,
        options: GridSettingsService.GetDialogOptions());

        await DeliveryDataGrid.DataGrid.Reload();
    }
}
