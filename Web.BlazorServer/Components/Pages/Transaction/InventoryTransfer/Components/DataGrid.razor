@using Web.BlazorServer.Components.Security
@using Web.BlazorServer.ViewModels.Transaction.InventoryTransfer

@inherits BaseComponent
<RadzenMediaQuery Query="(max-width: 912px)" Change="OnChange" />

<AppDataGrid @ref="@InventoryTransferRequestDataGrid"
             Id="posted_inventory_transfer_request_grid"
             TItem="InventoryTransferRequestDataGridVM"
             DataGetter="@LoadDataAsync"
             GridSettings="@InventoryTransferRequestDataGridSettings"
             @bind-GridSettingsLoaded="@GridSettingsLoaded"
             ActionName="@ActionName"
             SearchFilter="@_searchFilter">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <AppDataGridSearchBar TItem="InventoryTransferRequestDataGridVM"
                                  @bind-SearchFilter="_searchFilter"
                                  OnSearch="OnSearchAsync"
                                  Properties="@(new[] { nameof(InventoryTransferRequestDataGridVM.FromWhsName), nameof(InventoryTransferRequestDataGridVM.ToWhsName), nameof(InventoryTransferRequestDataGridVM.Remarks), nameof(InventoryTransferRequestDataGridVM.PreparedBy), nameof(InventoryTransferRequestDataGridVM.DocEntry) })" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="InventoryTransferRequestDataGrid.ReloadDataAsync" />
                <RadzenButton Visible="@(CreateItemURI is not null)" Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@CreateItem" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        @if (IsSmallScreen)
        {
            <RadzenDataGridColumn TItem="InventoryTransferRequestDataGridVM" Filterable="false" Pickable="false" Sortable="false">
                <Template Context="context">
                    <InventoryTransferCard InventoryTransfer="context" OnClick="ViewInventoryTransferRequest" IsDraft="IsDraft" />
                </Template>
            </RadzenDataGridColumn>
        }
        else
        {
            @if (IsDraft)
        {
            <RadzenDataGridColumn TItem="InventoryTransferRequestDataGridVM"
                                  Property="@nameof(InventoryTransferRequestDataGridVM.DocEntry)"
                                  Type="@typeof(int)"
                                  Title="Draft Entry" />
        }
        else
        {
            <RadzenDataGridColumn TItem="InventoryTransferRequestDataGridVM"
                                  Property="@nameof(InventoryTransferRequestDataGridVM.DocNum)"
                                  Type="@typeof(int)"
                                  Title="Doc Num" />
        }
        <RadzenDataGridColumn TItem="InventoryTransferRequestDataGridVM"
                              Property="@nameof(InventoryTransferRequestDataGridVM.FromWhsName)"
                              Type="@typeof(string)"
                              Title="From Warehouse">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InventoryTransferRequestDataGridVM"
                              Property="@nameof(InventoryTransferRequestDataGridVM.ToWhsName)"
                              Type="@typeof(string)"
                              Title="To Warehouse">
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InventoryTransferRequestDataGridVM"
                              Property="@nameof(InventoryTransferRequestDataGridVM.DocDate)"
                              Type="@typeof(DateOnly)"
                              FormatString="{0:d}"
                              Title="Doc Date">
            <Template>
                @context.DocDate.ToString("MM/dd/yyyy")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="InventoryTransferRequestDataGridVM"
                              Property="@nameof(InventoryTransferRequestDataGridVM.Remarks)"
                              Type="@typeof(string)"
                              Title="Remarks" />
        <RadzenDataGridColumn TItem="InventoryTransferRequestDataGridVM"
                              Property="@nameof(InventoryTransferRequestDataGridVM.PreparedBy)"
                              Type="@typeof(string)"
                              Title="Prepared By" />
        <RadzenDataGridColumn TItem="InventoryTransferRequestDataGridVM"
                              Frozen
                              FrozenPosition="FrozenColumnPosition.Right"
                              Filterable="false"
                              Sortable="false"
                              Width="35px">
            <Template>
                <RadzenButton Icon="visibility" Size="ButtonSize.ExtraSmall" Click="() => ViewInventoryTransferRequest(context)" />
            </Template>
        </RadzenDataGridColumn>}

    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="InventoryTransferRequestDataGridVM"
                                    @bind-Grid=@InventoryTransferRequestDataGrid.DataGrid
                                    @bind-GridSettings=@InventoryTransferRequestDataGridSettings />,
        options: GridSettingsService.GetDialogOptions());

        await InventoryTransferRequestDataGrid.DataGrid.Reload();
    }
    bool IsSmallScreen = false;

    async Task OnChange(bool matches)
    {
        if (matches != IsSmallScreen)
        {
            IsSmallScreen = matches;
            await InvokeAsync(StateHasChanged);
        }
    }
}