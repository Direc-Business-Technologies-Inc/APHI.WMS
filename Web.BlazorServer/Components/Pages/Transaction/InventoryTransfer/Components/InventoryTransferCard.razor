@using Web.BlazorServer.Helpers
@using Web.BlazorServer.ViewModels.Transaction.InventoryTransfer
@inherits BaseComponent


<RadzenCard onclick="@(() => OnClick.InvokeAsync(InventoryTransfer))" Variant="Variant.Outlined">
    <RadzenStack Gap="0" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenStack Gap="0">
            <RadzenText TextStyle="TextStyle.Overline" class=" rz-my-0">Inventory Transfer</RadzenText>
            <RadzenText Visible="IsDraft" TextStyle="TextStyle.H6" class="rz-my-0 rz-text-truncate"><strong>@InventoryTransfer.DocEntry.ToString().OrWhenNull("-")</strong></RadzenText>
            <RadzenText Visible="@(!IsDraft)" TextStyle="TextStyle.H6" class="rz-my-0 rz-text-truncate"><strong>@InventoryTransfer.DocNum.ToString().OrWhenNull("-")</strong></RadzenText>
        </RadzenStack>
        <RadzenText TextStyle="TextStyle.Subtitle2">@InventoryTransfer.DocDate.ToShortDateString()</RadzenText>
    </RadzenStack>
    <RadzenRow class="rz-mt-3" Gap="0" RowGap="0">
        <RadzenColumn SizeXS="6">
            <RadzenText TextStyle="TextStyle.Overline" class="rz-my-0">From Warehouse</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0  rz-text-truncate rz-text-caption">@InventoryTransfer.FromWhsName.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
        <RadzenColumn SizeXS="6">
            <RadzenText TextStyle="TextStyle.Overline" class="rz-my-0">To Warehouse</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0  rz-text-truncate rz-text-caption">@InventoryTransfer.ToWhsName.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
        <RadzenColumn SizeXS="6">
            <RadzenText TextStyle="TextStyle.Overline" class="rz-my-0">Prepared By</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0  rz-text-truncate rz-text-caption">@InventoryTransfer.PreparedBy.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
        <RadzenColumn SizeXS="6">
            <RadzenText TextStyle="TextStyle.Overline" class="rz-my-0">Remarks</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0  rz-text-truncate rz-text-caption">@InventoryTransfer.Remarks.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>


@code {
    [Parameter]
    [EditorRequired]
    public InventoryTransferRequestDataGridVM InventoryTransfer { get; set; }
    [Parameter]
    public bool IsDraft {get; set;} = false;

    [Parameter]
    public EventCallback<InventoryTransferRequestDataGridVM> OnClick { get; set; }
}