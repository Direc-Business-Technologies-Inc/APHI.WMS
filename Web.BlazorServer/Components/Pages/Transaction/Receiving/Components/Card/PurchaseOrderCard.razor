@using Web.BlazorServer.Helpers
@using Web.BlazorServer.ViewModels.Transaction.Receiving
@inherits BaseComponent

<RadzenCard onclick="@(() => OnClick.InvokeAsync(PurchaseOrder))" Variant="Variant.Outlined">
    <RadzenStack Gap="0" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
        <RadzenText TextStyle="TextStyle.Subtitle2"><strong>@PurchaseOrder.DocEntry</strong></RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle2">@PurchaseOrder.DocDate.ToShortDateString()</RadzenText>
    </RadzenStack>
    <RadzenRow class="rz-mt-2" Gap="0.5em" RowGap="0">
        <RadzenColumn >
            <RadzenText TextStyle="TextStyle.Overline" class="rz-mt-2 rz-my-0">Supplier Name</RadzenText>
            <RadzenText TextStyle="TextStyle.Body1" class="rz-my-0 rz-text-truncate">@PurchaseOrder.CardName.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
        <RadzenColumn >
            <RadzenText TextStyle="TextStyle.Overline" class="rz-mt-2 rz-my-0">Contact Person</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0  rz-text-truncate rz-text-caption">@PurchaseOrder.SupplierContactPerson.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
        <RadzenColumn Size="12">
            <RadzenText TextStyle="TextStyle.Overline" class="rz-mt-4 rz-my-0">Remarks</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-my-0 rz-text-truncate rz-text-caption">@PurchaseOrder.Remarks.OrWhenNull("-")</RadzenText>
        </RadzenColumn>
    </RadzenRow>
</RadzenCard>


@code {
    [Parameter]
    [EditorRequired]
    public PurchaseOrderDataGridVM PurchaseOrder { get; set; }
    [Parameter]
    public EventCallback<PurchaseOrderDataGridVM> OnClick { get; set; }
}