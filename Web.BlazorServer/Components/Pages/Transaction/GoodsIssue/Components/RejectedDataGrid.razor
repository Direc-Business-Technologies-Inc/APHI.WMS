@using Web.BlazorServer.Components.Pages.Transaction.GoodsIssue.Components.Cards
@using Web.BlazorServer.ViewModels.Transaction.GoodsIssue

@inherits BaseComponent
<RadzenMediaQuery Query="(max-width: 912px)" Change="OnChange" />

<AppDataGrid @ref="@GoodsIssueDataGrid" Id="rejected_goods_issue_grid" TItem="GoodsIssueDataGridVM" DataGetter="@LoadDataAsync" GridSettings="@GoodsIssueDataGridSettings" @bind-GridSettingsLoaded="@GridSettingsLoaded" ActionName="@ActionGetGoodsIssues" SearchFilter="@_searchFilter">
    <HeaderTemplate>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <AppDataGridSearchBar TItem="GoodsIssueDataGridVM"
                                  @bind-SearchFilter="_searchFilter"
                                  OnSearch="OnSearchAsync"
                                  Properties="@(new[] { nameof(GoodsIssueDataGridVM.TransTypeName), nameof(GoodsIssueDataGridVM.AcctName), nameof(GoodsIssueDataGridVM.PreparedBy), nameof(GoodsIssueDataGridVM.DocEntry) })" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" AlignItems="AlignItems.Center" Gap="8px">
                <RadzenButton Icon="settings" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@OpenTableSettings" />
                <RadzenButton Icon="sync" Size="ButtonSize.Small" Click="GoodsIssueDataGrid.ReloadDataAsync" />
                <RadzenButton Icon="add" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success" Click="@CreateGoodsIssue" />
            </RadzenStack>
        </RadzenStack>
    </HeaderTemplate>
    <GridColumns>
        @if (IsSmallScreen)
        {
            <RadzenDataGridColumn TItem="GoodsIssueDataGridVM" Filterable="false" Pickable="false" Sortable="false">
                <Template Context="context">
                    <GoodsIssueCard GoodsIssue="context" OnClick="ViewGoodsIssue" />
                </Template>
            </RadzenDataGridColumn>
        }
        else
        {
            <RadzenDataGridColumn TItem="GoodsIssueDataGridVM"
                                  Property="@nameof(GoodsIssueDataGridVM.DocEntry)"
                                  Type="@typeof(int)"
                                  Title="Doc No." />
            <RadzenDataGridColumn TItem="GoodsIssueDataGridVM"
                                  Property="@nameof(GoodsIssueDataGridVM.DocDate)"
                                  Type="@typeof(DateOnly)"
                                  FormatString="{0:d}"
                                  Title="Doc Date">
                <Template>
                    @context.DocDate.ToString("MM/dd/yyyy")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="GoodsIssueDataGridVM"
                                  Property="@nameof(GoodsIssueDataGridVM.PreparedBy)"
                                  Type="@typeof(string)"
                                  Title="Prepared By" />
            <RadzenDataGridColumn TItem="GoodsIssueDataGridVM"
                                  Property="@nameof(GoodsIssueDataGridVM.TransTypeName)"
                                  Type="@typeof(string)"
                                  Title="Trans. Type" />
            <RadzenDataGridColumn TItem="GoodsIssueDataGridVM"
                                  Frozen
                                  FrozenPosition="FrozenColumnPosition.Right"
                                  Width="35px"
                                  Filterable="false" Sortable="false" Pickable="false">
                <Template>
                    <RadzenButton Icon="visibility" Size="ButtonSize.ExtraSmall" Click="() => ViewGoodsIssue(context)" />
                </Template>
            </RadzenDataGridColumn>
        }
    </GridColumns>
</AppDataGrid>

@code {
    async Task OpenTableSettings()
    {
        await DialogService.OpenAsync(
            "Table Settings",
            ds => @<AppGridSettings TItem="GoodsIssueDataGridVM"
                                    @bind-Grid=@GoodsIssueDataGrid.DataGrid
                                    @bind-GridSettings=@GoodsIssueDataGridSettings />,
        options: GridSettingsService.GetDialogOptions());

        await GoodsIssueDataGrid.DataGrid.Reload();
    }
    bool IsSmallScreen = false;

    async Task OnChange(bool matches)
    {
        if (matches != IsSmallScreen)
        {
            IsSmallScreen = matches;
            await InvokeAsync(StateHasChanged);
        }
    }
}